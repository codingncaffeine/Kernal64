10 REM PARTITION TABLE: THE SYSTEM, THEN NATIVE PARTITIONS OF 16 MB TO THE END
20 L=PEEK(828)+256*PEEK(829)+65536*PEEK(830):OPEN15,30,15
30 PRINT#15,"P-H":PRINT#15,"P-N"
40 N=0:T=255:O=384:S=144:N$="SYSTEM":GOSUB100
50 O=528:FORN=1TO254:S=L-O:IFS>32640THENS=32640
60 S=INT(S/128)*128:IFS<128THEN80
70 T=1:N$="PARTITION"+STR$(N):GOSUB100:O=O+S:NEXT
80 PRINT#15,"P-U":CLOSE15:POKE831,N-1:PRINT"PARTITIONS"N-1:END
100 P$=CHR$(T)+CHR$(0)+CHR$(0)+N$:FORI=LEN(N$)TO15:P$=P$+CHR$(160):NEXT
110 H=INT(O/65536):M=INT(O/256)-H*256:P$=P$+CHR$(H)+CHR$(M)+CHR$(O-INT(O/256)*256)
120 P$=P$+CHR$(0)+CHR$(0)+CHR$(0)+CHR$(0)+CHR$(0)
130 H=INT(S/65536):M=INT(S/256)-H*256:P$=P$+CHR$(H)+CHR$(M)+CHR$(S-INT(S/256)*256)
140 PRINT#15,"P-P"+CHR$(N)+P$:PRINT#15,"P-W":RETURN
